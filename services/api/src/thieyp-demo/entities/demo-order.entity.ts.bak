export type DemoOrderStatus = 'pending' | 'prepared' | 'picked-up' | 'delivered';

export class DemoOrder {
  id: string;
  createdAt: string;
  status: DemoOrderStatus;
  restaurantSlug: string;
  restaurantName: string;
  customerName: string;
  customerAddress: string;
  totalAmount: number;
  currency: string;
}
