{
  "cli": {
    "version": ">= 11.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "ios": {
        "buildConfiguration": "Debug",
        "simulator": false
      },
      "corepack": true,
      "pnpm": "9.15.4",
      "cache": {
        "key": "delishafrica-pnpm-9.15.4-v2"
      },
      "channel": "development",
      "env": {
        "APP_VARIANT": "development"
      }
    },
    "production": {
      "autoIncrement": true,
      "channel": "production",
      "env": {
        "EXPO_PUBLIC_API_BASE_URL": "https://api.delishafrica.me/api/v1",
        "EXPO_PUBLIC_API_URL": "https://api.delishafrica.me/api/v1",
        "EXPO_PUBLIC_RELEASE_RING": "production"
      }
    },
    "preview": {
      "channel": "preview"
    },
    "ataraxie-closed": {
      "extends": "production",
      "distribution": "store",
      "channel": "ataraxie-closed",
      "environment": "production",
      "autoIncrement": true,
      "android": {
        "buildType": "app-bundle"
      },
      "env": {
        "DA_ATARAXIE_ANDROID_BUILD": "1",
        "EXPO_PUBLIC_API_BASE_URL": "https://ataraxie-api.delishafrica.me/api/v1",
        "EXPO_PUBLIC_API_URL": "https://ataraxie-api.delishafrica.me/api/v1",
        "EXPO_PUBLIC_RELEASE_RING": "ataraxie-closed"
      }
    },
    "ataraxie-ios-qa": {
      "extends": "production",
      "distribution": "store",
      "channel": "ataraxie-ios-qa",
      "environment": "production",
      "autoIncrement": true,
      "ios": {
        "simulator": false,
        "buildConfiguration": "Release"
      },
      "env": {
        "DA_ATARAXIE_IOS_BUILD": "1",
        "EXPO_PUBLIC_API_BASE_URL": "https://ataraxie-api.delishafrica.me/api/v1",
        "EXPO_PUBLIC_API_URL": "https://ataraxie-api.delishafrica.me/api/v1",
        "EXPO_PUBLIC_RELEASE_RING": "ataraxie-ios-qa"
      }
    }
  },
  "submit": {
    "production": {},
    "ataraxie-closed": {
      "android": {
        "track": "alpha",
        "releaseStatus": "completed",
        "changesNotSentForReview": false,
        "applicationId": "com.delishafrica.merchant"
      }
    },
    "ataraxie-ios-qa": {
      "ios": {
        "ascAppId": "6807369989"
      }
    }
  }
}
