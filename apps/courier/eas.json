{
  "cli": {
    "version": ">= 11.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "ios": {
        "buildConfiguration": "Debug",
        "simulator": false
      },
      "corepack": true,
      "pnpm": "9.15.4",
      "cache": {
        "key": "delishafrica-pnpm-9.15.4-v2"
      },
      "channel": "development",
      "env": {
        "APP_VARIANT": "development"
      }
    },
    "production": {
      "autoIncrement": true,
      "distribution": "store",
      "channel": "production",
      "corepack": true,
      "pnpm": "9.15.4",
      "ios": {
        "image": "macos-sequoia-15.6-xcode-26.0"
      },
      "env": {
        "APP_VARIANT": "production"
      },
      "android": {
        "image": "ubuntu-24.04-jdk-17-ndk-r27b"
      }
    },
    "preview": {
      "distribution": "internal",
      "channel": "preview",
      "corepack": true,
      "pnpm": "9.15.4",
      "ios": {
        "image": "sdk-54"
      },
      "env": {
        "APP_VARIANT": "preview"
      }
    }
  },
  "submit": {
    "production": {
      "ios": {
        "ascAppId": "6807372575"
      }
    }
  }
}
