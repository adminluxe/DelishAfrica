{
  "name": "courier",
  "version": "3.0.0",
  "private": true,
  "main": "index.js",
  "scripts": {
    "start": "expo start --dev-client",
    "ios": "expo run:ios",
    "android": "expo run:android",
    "reset-project": "node ./scripts/reset-project.js",
    "dev": "expo start --dev-client",
    "eas-build-pre-build": "bash scripts/tonton_eas_ios_prebuild_fix.sh",
    "eas-build-post-install": "echo EAS pnpm install completed",
    "eas-build-pre-install": "corepack enable && corepack prepare pnpm@9.15.4 --activate && pnpm --version",
    "dev:tunnel": "EXPO_NO_METRO_WORKSPACE_ROOT=1 expo start --dev-client --tunnel --port 8082 --clear",
    "dev:lan": "EXPO_NO_METRO_WORKSPACE_ROOT=1 expo start --dev-client --lan --port 8082 --clear",
    "start:tunnel": "expo start --dev-client --tunnel -c --port 8082",
    "start:lan": "EXPO_NO_METRO_WORKSPACE_ROOT=1 pnpm exec expo start --dev-client --lan -c --port 8082",
    "start:local": "EXPO_NO_METRO_WORKSPACE_ROOT=1 pnpm exec expo start --dev-client --host localhost -c --port 8082",
    "build:ios:dev": "eas build -p ios --profile development --clear-cache"
  },
  "dependencies": {
    "@delishafrica/ui": "file:vendor/ui",
    "@expo/metro-runtime": "~6.1.2",
    "@react-navigation/bottom-tabs": "^7.0.0",
    "@react-navigation/core": "^7.0.0",
    "@react-navigation/elements": "^2.8.4",
    "@react-navigation/native": "^7.0.0",
    "@react-navigation/stack": "^7.0.0",
    "dotenv": "^17.3.1",
    "expo": "~54.0.0",
    "expo-asset": "^12.0.11",
    "expo-constants": "~18.0.10",
    "expo-dev-client": "^6.0.20",
    "expo-font": "~14.0.9",
    "expo-haptics": "~15.0.7",
    "expo-image": "~3.0.10",
    "expo-linear-gradient": "~15.0.8",
    "expo-linking": "~8.0.11",
    "expo-location": "^19.0.7",
    "expo-modules-core": "~3.0.29",
    "expo-router": "~6.0.22",
    "expo-secure-store": "~15.0.8",
    "expo-splash-screen": "~31.0.10",
    "expo-status-bar": "~3.0.8",
    "expo-symbols": "~1.0.7",
    "expo-system-ui": "~6.0.7",
    "expo-web-browser": "~15.0.9",
    "hoist-non-react-statics": "^3.3.2",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-native": "0.81.5",
    "react-native-gesture-handler": "~2.28.0",
    "react-native-is-edge-to-edge": "^1.2.1",
    "react-native-reanimated": "4.1.5",
    "react-native-safe-area-context": "~5.6.2",
    "react-native-screens": "~4.16.0",
    "react-native-worklets": "0.5.1",
    "regenerator-runtime": "^0.14.1"
  },
  "devDependencies": {
    "@expo/ngrok": "^4.1.3",
    "@types/react": "~19.1.10",
    "babel-plugin-module-resolver": "^5.0.0",
    "babel-preset-expo": "^54.0.10"
  },
  "delishAfricaOriginalMain": "expo-router/entry",
  "type": "commonjs",
  "packageManager": "pnpm@9.15.4"
}
