---
import "../styles/global.css";
import TopNav from "../components/TopNav.astro";
import BrandMark from "../components/BrandMark.astro";
import WaterLayer from "../components/WaterLayer.astro";
import { site, release } from "../config/site";
interface Props {
  title?: string;
  description?: string;
  eyebrow?: string;
  lang?: "fr" | "en";
  alternatePath?: string;
  noindex?: boolean;
  preloadHero?: boolean;
}
const {
  title = site.title,
  description = site.description,
  eyebrow = site.mode,
  lang = "fr",
  alternatePath,
  noindex = false,
  preloadHero = false,
} = Astro.props;
const canonical = new URL(Astro.url.pathname, site.url);
const robots = noindex || !site.indexable ? "noindex,nofollow,noarchive" : "index,follow,max-image-preview:large,max-snippet:-1,max-video-preview:-1";
const alternate = alternatePath ? new URL(alternatePath, site.url) : undefined;
const locale = lang === "en" ? "en_GB" : "fr_BE";
const alternateLocale = lang === "en" ? "fr_BE" : "en_GB";
const organizationSchema = {
  "@context": "https://schema.org",
  "@type": "Organization",
  name: site.name,
  url: site.url,
  logo: `${site.url}/media/brand/delishafrica-mark-gold-512.webp`,
  email: site.supportEmail,
};
const websiteSchema = {
  "@context": "https://schema.org",
  "@type": "WebSite",
  name: site.name,
  url: site.url,
  inLanguage: lang,
  description,
};
---
<!doctype html>
<html lang={lang}>
<head>
  <meta charset="UTF-8"/>
  <meta name="viewport" content="width=device-width, initial-scale=1"/>
  <meta name="theme-color" content="#f4f0e7"/>
  <meta name="color-scheme" content="light dark"/>
  <script src="/theme-controller-v3.js"></script>
  <meta name="robots" content={robots}/>
  <meta name="description" content={description}/>
  <meta property="og:type" content="website"/>
  <meta property="og:site_name" content={site.name}/>
  <meta property="og:locale" content={locale}/>
  <meta property="og:locale:alternate" content={alternateLocale}/>
  <meta property="og:title" content={title}/>
  <meta property="og:description" content={description}/>
  <meta property="og:url" content={canonical.toString()}/>
  <meta property="og:image" content={`${site.url}/og-preview.svg`}/>
  <meta property="og:image:alt" content="DelishAfrica — Le goût d’un continent, mis en mouvement"/>
  <meta name="twitter:card" content="summary_large_image"/>
  <meta name="twitter:title" content={title}/>
  <meta name="twitter:description" content={description}/>
  <meta name="twitter:image" content={`${site.url}/og-preview.svg`}/>
  <link rel="canonical" href={canonical.toString()}/>
  <link rel="alternate" hreflang={lang} href={canonical.toString()}/>
  {alternate && <link rel="alternate" hreflang={lang === "fr" ? "en" : "fr"} href={alternate.toString()}/>}
  <link rel="alternate" hreflang="x-default" href={site.url}/>
  <script type="application/ld+json" set:html={JSON.stringify(organizationSchema)}></script>
  <script type="application/ld+json" set:html={JSON.stringify(websiteSchema)}></script>
  <link rel="icon" href="/media/brand/favicon.png" type="image/png"/>
  <link rel="manifest" href="/site.webmanifest.json"/>
  {preloadHero && (
    <link
      rel="preload"
      as="image"
      href="/media/partners/thieyp/chicken-800.webp"
      imagesrcset="/media/partners/thieyp/chicken-480.webp 480w, /media/partners/thieyp/chicken-800.webp 800w, /media/partners/thieyp/chicken-1000.webp 1000w"
      imagesizes="(max-width: 1180px) 100vw, 48vw"
      fetchpriority="high"
    />
  )}

  <!-- One non-blocking bundle replaces ten render-blocking WATER/GALA requests. -->
  <meta name="da-water-signature" content="water-gala-v11-bundled-20260929"/>
  <link rel="stylesheet" href="/water-live-v11.bundle.css?v=20260929" data-da-water-bundle="v11"/>
  <link rel="stylesheet" href="/delish-theme-v2.css?v=20260929" data-da-theme-css="v2"/>
  <title>{title}</title>
</head>
<body class="water-signature-v11-enabled water-signature-v11-final water-app-parity-v2">
  <div class="da-rain-canopy-v4" data-da-rain-canopy="v4" aria-hidden="true">
    <span class="da-rain-track-v4 da-rain-far-v4"></span>
    <span class="da-rain-track-v4 da-rain-near-v4"></span>
    <span class="da-wet-lens-v4"></span>
    <span class="da-specular-v4"></span>
    <span class="da-gravity-drop-v4 da-gravity-drop-a-v4"></span>
    <span class="da-gravity-drop-v4 da-gravity-drop-b-v4"></span>
  </div>
  <a class="skip-link" href="#main">{lang === "en" ? "Skip to content" : "Aller au contenu"}</a>
  <div class="grain" aria-hidden="true"></div>
  <div class="ambient ambient-a" aria-hidden="true"></div>
  <div class="ambient ambient-b" aria-hidden="true"></div>
  <WaterLayer/>
  <TopNav eyebrow={eyebrow} lang={lang}/>
  <main id="main"><slot /></main>
  <footer class="site-footer shell">
    <div class="footer-brand"><BrandMark compact/><p>{lang === "en" ? "A digital house built to amplify African food cultures without diluting their voices." : "Une maison numérique pour faire rayonner les cuisines africaines sans diluer leurs voix."}</p></div>
    <div class="footer-links">
      <a href={lang === "en" ? "/en/restaurants/" : "/restaurants/"}>Restaurants</a>
      <a href={lang === "en" ? "/en/trust/" : "/trust/"}>{lang === "en" ? "Trust" : "Confiance"}</a>
      <a href={lang === "en" ? "/en/support/" : "/support/"}>Support</a>
      <a href={lang === "en" ? "/en/accessibility/" : "/accessibility/"}>{lang === "en" ? "Accessibility" : "Accessibilité"}</a>
      <a href={lang === "en" ? "/en/privacy/" : "/privacy/"}>{lang === "en" ? "Privacy" : "Confidentialité"}</a>
      <a href={lang === "en" ? "/en/cookies/" : "/cookies/"}>Cookies</a>
      <a href={lang === "en" ? "/en/terms/" : "/terms/"}>{lang === "en" ? "Terms" : "Conditions"}</a>
      <a href={lang === "en" ? "/en/legal/" : "/legal/"}>{lang === "en" ? "Legal notice" : "Mentions légales"}</a>
    </div>
    <div class="footer-meta"><span>{release.production ? "AFRICAN FOOD, FORWARD" : "C6 · PRODUCTION CANDIDATE PREVIEW"}</span><span>{lang === "en" ? "EN · FR" : "FR · EN"}</span><span>© 2026 DelishAfrica®</span></div>
    <div class="footer-powered">
      <span class="footer-powered-kicker">{lang === "en" ? "A PURPLE ORCHID GROUP EXPERIENCE" : "UNE EXPÉRIENCE PURPLE ORCHID GROUP"}</span>
      <strong>{lang === "en" ? "Premium digital house" : "Maison numérique premium"}</strong>
    </div>
  </footer>
</body>
</html>
