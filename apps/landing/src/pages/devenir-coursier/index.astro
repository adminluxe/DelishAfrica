---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { release, appGateways } from "../../config/site";
---
<BaseLayout title="Devenir coursier — DelishAfrica®" description="Étapes de candidature coursier et séparation des documents sensibles." alternatePath="/en/become-a-courier/">
  <section class="gateway-v3 shell gateway-apply"><div><p class="eyebrow">COURIER ONBOARDING</p><h1>Votre route commence par un parcours digne de confiance.</h1><p class="hero-lead">Candidature, documents, contrôle et activation sont séparés du contenu éditorial public.</p><div class="hero-actions">{release.production ? <><a class="button button-primary" href={appGateways.courier.web}>Ouvrir l’espace Courier</a><a class="button button-ghost" href="#journey">Voir les étapes</a></> : <><a class="button button-primary" href="/devenir-coursier/simulateur/">Tester le parcours privé</a><a class="button button-ghost" href="/courier/">Découvrir Courier</a></>}</div></div><div class="gateway-panel apply-panel"><span>{release.production ? "COURIER INTAKE" : "PRIVATE INTAKE"}</span><strong>KYC<br/>SEPARATED</strong><small>{release.production ? "APPLICATION · REVIEW · ACTIVATION" : "SYNTHETIC SIMULATOR · NO NETWORK"}</small></div></section>
  <section id="journey" class="section shell onboarding-timeline"><article><span>01</span><h3>Informations</h3><p>Identité, ville, contact et mode de mobilité.</p></article><article><span>02</span><h3>Dossier</h3><p>Création d’un identifiant de candidature distinct.</p></article><article><span>03</span><h3>Documents</h3><p>Selfie, identité, permis selon véhicule et justificatif d’adresse.</p></article><article><span>04</span><h3>Contrôle</h3><p>Vérification OPS avec décisions et traces séparées.</p></article><article><span>05</span><h3>Activation</h3><p>Passage vers Courier après validation, jamais avant.</p></article></section>
  <section class="section shell document-vault"><div><p class="eyebrow">DOCUMENT VAULT</p><h2>Les pièces d’identité ne sont pas du contenu web.</h2><p>La candidature utilise un parcours dédié, un stockage privé et une supervision authentifiée.</p></div><div class="vault-list"><span>SELFIE</span><span>ID FRONT</span><span>ID BACK</span><span>DRIVING LICENCE · IF REQUIRED</span><span>PROOF OF ADDRESS</span></div></section>
  {!release.production && <section class="private-disclosure shell"><strong>SIMULATEUR SYNTHÉTIQUE</strong><p>C6 conserve un parcours local sans réseau, stockage, fichier ou donnée réelle.</p></section>}
</BaseLayout>
