---
import BaseLayout from "../../layouts/BaseLayout.astro";
import PreparedAppLink from "../../components/PreparedAppLink.astro";
---
<BaseLayout title="Expérience Merchant — DelishAfrica®" description="Présence éditoriale, onboarding et cockpit cuisine pour les partenaires." alternatePath="/en/merchant/">
  <section class="gateway-v3 shell gateway-merchant"><div><p class="eyebrow">MERCHANT · GROW THE TABLE</p><h1>Faire grandir sa table sans diluer son identité.</h1><p class="hero-lead">La landing accueille le restaurant, raconte sa cuisine et prépare un onboarding progressif vers le cockpit Merchant.</p><div class="hero-actions"><a class="button button-primary" href="/restaurants/thieyp/">Voir une présence partenaire</a><a class="button button-ghost" href="/trust/">Voir le cadre de confiance</a></div></div><div class="gateway-panel merchant-panel"><span>KITCHEN ORACLE</span><strong>VOICE<br/>TO SCALE</strong><small>PROFILE · ORDERS · OPERATIONS</small></div></section>
  <section class="section shell merchant-steps"><article><span>01</span><h3>Présence éditoriale</h3><p>Nom, quartier, cuisine, menu, horaires et histoire deviennent une présence cohérente.</p></article><article><span>02</span><h3>Onboarding progressif</h3><p>Les données sensibles restent dans des circuits séparés de la vitrine publique.</p></article><article><span>03</span><h3>Cockpit quotidien</h3><p>Commandes, cuisine, alertes et qualité sont pilotées dans Merchant.</p></article><article><span>04</span><h3>Croissance mesurée</h3><p>La marque du restaurant reste lisible à mesure que la portée augmente.</p></article></section>
  <section class="section shell merchant-proof"><div><p class="eyebrow">PARTNER PROMISE</p><h2>Votre cuisine n’est pas un simple fournisseur de catalogue.</h2><p>DelishAfrica® doit protéger la voix, l’origine et la valeur du partenaire dans chaque interface.</p></div><div class="merchant-ledger"><span>IDENTITÉ</span><span>MENU</span><span>OPÉRATIONS</span><span>QUALITÉ</span></div></section>
  <section class="section shell"><PreparedAppLink role="merchant" label="Ouverture Merchant préparée" detail="Le scheme actif est référencé, mais aucun mécanisme public d’association de domaine n’est activé en C3."/></section>
</BaseLayout>
