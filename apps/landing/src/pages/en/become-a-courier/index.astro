---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import { release, appGateways } from "../../../config/site";
---
<BaseLayout lang="en" title="Become a courier — DelishAfrica®" description="Courier application stages and separation of sensitive documents." alternatePath="/devenir-coursier/">
  <section class="gateway-v3 shell gateway-apply"><div><p class="eyebrow">COURIER ONBOARDING</p><h1>Your route begins with a trustworthy journey.</h1><p class="hero-lead">Application, documents, review and activation remain separate from public editorial content.</p><div class="hero-actions">{release.production ? <><a class="button button-primary" href={appGateways.courier.web}>Open Courier space</a><a class="button button-ghost" href="#journey">See the stages</a></> : <><a class="button button-primary" href="/en/become-a-courier/simulator/">Test the private journey</a><a class="button button-ghost" href="/en/courier/">Discover Courier</a></>}</div></div><div class="gateway-panel apply-panel"><span>{release.production ? "COURIER INTAKE" : "PRIVATE INTAKE"}</span><strong>KYC<br/>SEPARATED</strong><small>{release.production ? "APPLICATION · REVIEW · ACTIVATION" : "SYNTHETIC SIMULATOR · NO NETWORK"}</small></div></section>
  <section id="journey" class="section shell onboarding-timeline"><article><span>01</span><h3>Information</h3><p>Identity, city, contact and mobility mode.</p></article><article><span>02</span><h3>File</h3><p>A distinct application identifier is created.</p></article><article><span>03</span><h3>Documents</h3><p>Selfie, identity, driving licence when required and proof of address.</p></article><article><span>04</span><h3>Review</h3><p>OPS review with separate decisions and traces.</p></article><article><span>05</span><h3>Activation</h3><p>Courier access only follows validation.</p></article></section>
  {!release.production && <section class="private-disclosure shell"><strong>SYNTHETIC SIMULATOR</strong><p>C6 keeps a local journey with no network, storage, file or real personal data.</p></section>}
</BaseLayout>
