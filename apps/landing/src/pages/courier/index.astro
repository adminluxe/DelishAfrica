import BaseLayout from "../../layouts/BaseLayout.astro";
import PreparedAppLink from "../../components/PreparedAppLink.astro";
---
<BaseLayout title="Expérience Courier — DelishAfrica®" description="Candidature, confiance, missions et progression dans une expérience terrain claire." alternatePath="/en/courier/">
  <section class="gateway-v3 shell gateway-courier"><div><p class="eyebrow">COURIER · MOVE THE FUTURE</p><h1>Une mission claire. Une route lisible. Une progression digne.</h1><p class="hero-lead">La landing explique le réseau. Courier prend le relais pour les documents, les missions, l’ETA et l’activité terrain.</p><div class="hero-actions"><a class="button button-primary" href="/devenir-coursier/">Découvrir la candidature</a><a class="button button-ghost" href="/trust/">Comprendre la séparation des données</a></div></div><div class="gateway-panel courier-panel"><span>ROUTE ORACLE</span><strong>TRUST<br/>IN MOTION</strong><small>ONBOARDING · ETA · MISSIONS</small></div></section>
  <section class="section shell courier-journey"><article><span>01</span><h3>Comprendre</h3><p>Conditions, étapes et documents sont expliqués avant toute collecte.</p></article><article><span>02</span><h3>Candidater</h3><p>Le futur formulaire restera derrière un contrat same-origin et versionné.</p></article><article><span>03</span><h3>Être vérifié</h3><p>Les pièces KYC restent privées, contrôlées et séparées du contenu public.</p></article><article><span>04</span><h3>Être activé</h3><p>L’application Courier devient l’espace d’activité, de missions et de progression.</p></article></section>
  <section class="section shell route-preview"><div class="route-map"><span class="route-point point-a">R</span><span class="route-line"></span><span class="route-point point-b">C</span></div><div><p class="eyebrow">ETA &amp; MISSION CLARITY</p><h2>La technologie sert la décision terrain.</h2><p>Distance, statut et prochaine action doivent être compris en quelques secondes, sans automatiser une récupération ou une livraison.</p></div></section>
  <section class="section shell"><PreparedAppLink role="courier" label="Ouverture Courier préparée" detail="Le scheme applicatif est connu. La liaison domaine-app restera inactive tant que les fichiers d’association ne sont pas validés."/></section>
</BaseLayout>
