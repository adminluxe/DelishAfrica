---
interface Props { number: string; name: string; promise: string; description: string; href: string; image: string; tone: "client" | "merchant" | "courier" }
const { number, name, promise, description, href, image, tone } = Astro.props;
---
<a class:list={["experience-door", `door-${tone}`]} href={href}>
  <div class="door-visual"><img src={image} alt="" /></div>
  <div class="door-copy"><span>{number} · {name}</span><h3>{promise}</h3><p>{description}</p><strong>Entrer dans l’univers <i aria-hidden="true">↗</i></strong></div>
</a>
