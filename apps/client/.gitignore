/ios
/android

# DA: allow EAS custom build configs (needed for EAS upload)
!.eas/
!.eas/build/
!.eas/build/*.yml
!.eas/build/*.yaml

# --- DelishAfrica: unignore EAS build configs (DO NOT REMOVE) ---
# EAS needs these files in the upload context (custom build configs)
!.eas/
!.eas/build/
!.eas/build/**
!.eas/build/*.yml
!.eas/build/*.yaml
# --- EAS build configs (DO NOT REMOVE) ---
