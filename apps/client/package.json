{
  "name": "client",
  "main": "index.js",
  "version": "3.0.0",
  "scripts": {
    "start": "pnpm run start:tunnel",
    "reset-project": "node ./scripts/reset-project.js",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "lint": "expo lint",
    "dev": "pnpm run start:tunnel",
    "eas-build-pre-build": "bash scripts/tonton_eas_ios_prebuild_fix.sh",
    "eas-build-post-install": "echo EAS pnpm install completed",
    "eas-build-pre-install": "corepack enable && corepack prepare pnpm@9.15.4 --activate && pnpm --version",
    "typecheck": "tsc --noEmit",
    "check": "pnpm typecheck",
    "tunnel": "expo start --dev-client --tunnel --port 8081",
    "dev:tunnel": "EXPO_NO_METRO_WORKSPACE_ROOT=1 expo start --dev-client --tunnel --port 8081 --clear",
    "dev:lan": "EXPO_NO_METRO_WORKSPACE_ROOT=1 expo start --dev-client --lan --port 8081 --clear",
    "start:tunnel": "expo start --dev-client --tunnel -c --port 8081",
    "start:lan": "EXPO_NO_METRO_WORKSPACE_ROOT=1 pnpm exec expo start --dev-client --lan -c --port 8081",
    "start:local": "EXPO_NO_METRO_WORKSPACE_ROOT=1 pnpm exec expo start --dev-client --host localhost -c --port 8081",
    "build:ios:dev": "eas build -p ios --profile development --clear-cache"
  },
  "dependencies": {
    "@babel/runtime": "^7.28.4",
    "@delishafrica/ui": "file:vendor/ui",
    "@expo/vector-icons": "^15.0.2",
    "@react-navigation/bottom-tabs": "^7.8.11",
    "@react-navigation/core": "^7.0.0",
    "@react-navigation/elements": "^2.6.3",
    "@react-navigation/native": "^7.1.24",
    "@react-navigation/stack": "^7.0.0",
    "@stripe/stripe-react-native": "0.50.3",
    "ansi-styles": "^6.2.3",
    "dotenv": "^17.3.1",
    "expo": "~54.0.32",
    "expo-asset": "^12.0.11",
    "expo-auth-session": "~7.0.10",
    "expo-constants": "~18.0.10",
    "expo-crypto": "~15.0.8",
    "expo-dev-client": "^6.0.20",
    "expo-font": "~14.0.9",
    "expo-haptics": "~15.0.8",
    "expo-image": "~3.0.10",
    "expo-linking": "~8.0.11",
    "expo-secure-store": "~15.0.8",
    "expo-splash-screen": "~31.0.10",
    "expo-status-bar": "~3.0.8",
    "expo-symbols": "~1.0.7",
    "expo-system-ui": "~6.0.7",
    "expo-web-browser": "~15.0.8",
    "express": "^5.2.1",
    "hoist-non-react-statics": "^3.3.2",
    "invariant": "^2.2.4",
    "pretty-format": "^30.2.0",
    "react": "19.1.0",
    "react-devtools-core": "^7.0.1",
    "react-dom": "19.1.0",
    "react-is": "^19.2.1",
    "react-native": "0.81.5",
    "react-native-gesture-handler": "~2.28.0",
    "react-native-is-edge-to-edge": "^1.2.1",
    "react-native-reanimated": "4.1.5",
    "react-native-safe-area-context": "~5.6.2",
    "react-native-screens": "~4.16.0",
    "react-native-web": "~0.21.0",
    "react-native-worklets": "0.5.1",
    "regenerator-runtime": "^0.14.1",
    "whatwg-fetch": "^3.6.20"
  },
  "devDependencies": {
    "@expo/metro-runtime": "~6.1.2",
    "@expo/ngrok": "^4",
    "@react-native-async-storage/async-storage": "^2.2.0",
    "@types/node": "^24.10.9",
    "@types/react": "~19.1.0",
    "babel-plugin-module-resolver": "^5.0.0",
    "babel-preset-expo": "^54.0.10",
    "eslint": "^9.25.0",
    "eslint-config-expo": "~10.0.0",
    "expo-location": "^19.0.7",
    "expo-router": "~6.0.23",
    "metro": "^0.83.3",
    "metro-config": "^0.83.3",
    "metro-resolver": "^0.83.3",
    "metro-runtime": "^0.83.3",
    "react-native-maps": "^1.20.1",
    "socket.io-client": "^4.8.1",
    "typescript": "~5.9.3"
  },
  "private": true,
  "expo": {},
  "delishAfricaOriginalMain": "expo-router/entry",
