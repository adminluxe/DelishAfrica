{
  "name": "delishafrica-monorepo",
  "private": true,
  "packageManager": "pnpm@9.15.4",
  "scripts": {
    "client:dev": "pnpm --dir apps/client run start:tunnel",
    "courier:dev": "pnpm --dir apps/courier run start:tunnel",
    "merchant:dev": "pnpm --dir apps/merchant run start:tunnel",
    "dev": "turbo run dev --parallel",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "format": "prettier -w .",
    "typecheck": "turbo run typecheck",
    "client:dev:lan": "pnpm --dir apps/client run start:lan",
    "courier:dev:lan": "pnpm --dir apps/courier run start:lan",
    "merchant:dev:lan": "pnpm --dir apps/merchant run start:lan",
    "client:lan": "pnpm --dir apps/client run start:lan",
    "courier:lan": "pnpm --dir apps/courier run start:lan",
    "merchant:lan": "pnpm --dir apps/merchant run start:lan"
  },
  "devDependencies": {
    "@babel/core": "^7.28.5",
    "@types/node": "^20.11.30",
    "babel-preset-expo": "^54.0.9",
    "prettier": "^3.3.3",
    "react-native-reanimated": "~4.1.1",
    "ts-node": "^10.9.2",
    "turbo": "^2.1.1",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "@babel/runtime": "^7.28.4",
    "@expo/metro-runtime": "~6.1.2",
