services:
  db:
    image: postgres:15
    container_name: delish-db
    restart: unless-stopped
    environment:
      POSTGRES_DB: delish_db
      POSTGRES_USER: delish
      POSTGRES_PASSWORD: secret
    ports:
      - "5433:5432"
    volumes:
      - pgdata:/var/lib/postgresql/data

  redis:
    image: redis:7
    container_name: delish-redis
    restart: unless-stopped
    ports:
      - "6379:6379"

  api:
    image: node:20-bullseye
    container_name: delish-api
    restart: unless-stopped
    depends_on:
      - db
      - redis
    working_dir: /app
    environment:
      NODE_ENV: development
      PORT: "3010"
      DATABASE_URL: postgresql://delish:secret@db:5432/delish_db
      REDIS_URL: redis://redis:6379
    ports:
      - "3010:3010"
    volumes:
      - ./:/app
      - api_root_node_modules:/app/node_modules
      - api_nest_node_modules:/app/services/api-nest/node_modules
    command:
      - bash
      - -lc
      - |
          set -e
          echo "--- Delish API (api-nest) ---"

          corepack enable >/dev/null 2>&1 || true

          if [ ! -f /app/services/api-nest/package.json ]; then
            echo "❌ /app/services/api-nest/package.json introuvable"
            echo "package.json détectés:"
            find /app -maxdepth 6 -name package.json | head -n 120 || true
            exit 1
          fi

          cd /app
          echo "Workspace install..."
          pnpm install --no-frozen-lockfile

          cd /app/services/api-nest

          echo "Scripts disponibles (api-nest):"
          node - <<'NODE'
          const pkg=require('./package.json');
          console.log(pkg.scripts || {});
NODE

          SCRIPT="$(node - <<'NODE'
          const s=(require('./package.json').scripts)||{};
          const keys=Object.keys(s);
          const pref=[
            'start:dev','start:debug','start:local',
            'dev','start','start:prod',
            'serve','api','start:api'
          ];
          let pick=pref.find(k=>s[k]);
          if(!pick){
            pick = keys.find(k=>/^start(:dev|:debug|:local|:prod)?$/.test(k))
                || keys.find(k=>k.includes('start'))
                || keys.find(k=>k.includes('dev'));
          }
          if(!pick){ process.exit(2); }
          process.stdout.write(pick);
NODE
          )" || true

          if [ -z "$SCRIPT" ]; then
            echo "❌ Aucun script utilisable trouvé dans services/api-nest/package.json"
            exit 2
          fi

          echo "▶ Running: pnpm run $SCRIPT"
          pnpm run "$SCRIPT"

volumes:
  pgdata:
  api_root_node_modules:
  api_nest_node_modules:
