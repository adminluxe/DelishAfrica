{
  "name": "delishafrica-monorepo",
  "private": true,
  "packageManager": "pnpm@9.15.4",
  "scripts": {
    "client:dev": "bash ./scripts/da_app_dev.sh client --tunnel",
    "courier:dev": "bash ./scripts/da_app_dev.sh courier --tunnel",
    "merchant:dev": "bash ./scripts/da_app_dev.sh merchant --tunnel",
    "dev": "turbo run dev --parallel",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "format": "prettier -w .",
    "typecheck": "turbo run typecheck",
    "client:dev": "pnpm --filter ./apps/client exec -- expo start --dev-client -c",
    "client:dev:lan": "bash ./scripts/da_app_dev.sh client --lan",
    "courier:dev:lan": "bash ./scripts/da_app_dev.sh courier --lan",
    "merchant:dev:lan": "bash ./scripts/da_app_dev.sh merchant --lan"
  },
