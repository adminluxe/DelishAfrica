// 1. Structure du projet
async function collectProjectStructure() {
console.log(‘📁 Analyse de la structure…’);

const structure = {
apps: [],
directories: [],
rootFiles: []
};

// Lister le contenu du dossier racine
const items = fs.readdirSync(PROJECT_ROOT);

for (const item of items) {
if (item.startsWith(’.’) || item === ‘node_modules’) continue;

```
const fullPath = path.join(PROJECT_ROOT, item);
const stat = fs.statSync(fullPath);

if (stat.isDirectory()) {
structure.directories.push(item);

// Vérifier si c'est une app React Native
const hasPackageJson = fs.existsSync(path.join(fullPath, 'package.json'));
const hasAppJson = fs.existsSync(path.join(fullPath, 'app.json'));
const hasSrc = fs.existsSync(path.join(fullPath, 'src'));

if (hasPackageJson || hasAppJson) {
const appInfo = {
name: item,
path: fullPath,
hasPackageJson,
hasAppJson,
hasSrc,
folders: []
};

try {
appInfo.folders = fs.readdirSync(fullPath)
.filter(d => {
const p = path.join(fullPath, d);
return fs.statSync(p).isDirectory() && !d.startsWith('.');
});
} catch (e) {
appInfo.folders = [];
}

structure.apps.push(appInfo);
}
} else {
structure.rootFiles.push(item);
}
```

}

// Arborescence complète (limitée à 2 niveaux)
structure.tree = getDirectoryTree(PROJECT_ROOT, 2);

projectData.structure = structure;
}

// Arbre de répertoires
function getDirectoryTree(dir, maxDepth, currentDepth = 0) {
if (currentDepth >= maxDepth) return null;

const tree = {};

try {
const items = fs.readdirSync(dir);

```
for (const item of items) {
if (item.startsWith('.') || item === 'node_modules') continue;

const fullPath = path.join(dir, item);
const stat = fs.statSync(fullPath);

if (stat.isDirectory()) {
tree[item] = getDirectoryTree(fullPath, maxDepth, currentDepth + 1);
} else {
tree[item] = 'file';
}
}
```

} catch (e) {
return null;
}

return tree;
}

