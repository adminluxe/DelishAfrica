// Utilitaires de recherche de fichiers
function findFiles(dir, filename, maxDepth, currentDepth = 0) {
if (currentDepth >= maxDepth) return [];

let results = [];

try {
const items = fs.readdirSync(dir);

```
for (const item of items) {
if (item.startsWith('.') || item === 'node_modules' || item === 'android' || item === 'ios') continue;

const fullPath = path.join(dir, item);
const stat = fs.statSync(fullPath);

if (stat.isDirectory()) {
results.push(...findFiles(fullPath, filename, maxDepth, currentDepth + 1));
} else if (item === filename) {
results.push(fullPath);
}
}
```

} catch (e) {
// Ignorer erreurs
}

return results;
}

function findFilesRecursive(dir, filenames, maxDepth, currentDepth = 0) {
if (currentDepth >= maxDepth) return [];

let results = [];

try {
const items = fs.readdirSync(dir);

```
for (const item of items) {
if (item.startsWith('.') || item === 'node_modules' || item === 'android' || item === 'ios') continue;

const fullPath = path.join(dir, item);
const stat = fs.statSync(fullPath);

if (stat.isDirectory()) {
results.push(...findFilesRecursive(fullPath, filenames, maxDepth, currentDepth + 1));
} else if (filenames.includes(item)) {
results.push(fullPath);
}
}
```

} catch (e) {
// Ignorer
}

return results;
}

function findDirectories(dir, dirname, maxDepth, currentDepth = 0) {
if (currentDepth >= maxDepth) return [];

let results = [];

try {
const items = fs.readdirSync(dir);

```
for (const item of items) {
if (item.startsWith('.') || item === 'node_modules' || item === 'android' || item === 'ios') continue;

const fullPath = path.join(dir, item);
const stat = fs.statSync(fullPath);

if (stat.isDirectory()) {
if (item === dirname) {
results.push(fullPath);
}
results.push(...findDirectories(fullPath, dirname, maxDepth, currentDepth + 1));
}
}
```

} catch (e) {
// Ignorer
}

return results;
}

function findFilesInDirectory(dir, extensions, maxDepth, currentDepth = 0) {
if (currentDepth >= maxDepth) return [];

let results = [];

try {
const items = fs.readdirSync(dir);

```
for (const item of items) {
if (item.startsWith('.')) continue;

const fullPath = path.join(dir, item);
const stat = fs.statSync(fullPath);

if (stat.isDirectory()) {
results.push(...findFilesInDirectory(fullPath, extensions, maxDepth, currentDepth + 1));
} else {
const ext = path.extname(item);
if (extensions.includes(ext)) {
results.push(fullPath);
}
}
}
```

} catch (e) {
// Ignorer
}

return results;
}

function getAllFilesInDirectory(dir, maxDepth, currentDepth = 0) {
if (currentDepth >= maxDepth) return [];

let results = [];

try {
const items = fs.readdirSync(dir);

```
for (const item of items) {
if (item.startsWith('.')) continue;

const fullPath = path.join(dir, item);
const stat = fs.statSync(fullPath);

if (stat.isDirectory()) {
results.push(...getAllFilesInDirectory(fullPath, maxDepth, currentDepth + 1));
} else {
results.push(fullPath);
}
}
```

} catch (e) {
// Ignorer
}

return results;
}

function readFileSamples(files, limit) {
const samples = [];

for (const file of files.slice(0, limit)) {
try {
const content = fs.readFileSync(file, ‘utf-8’);
samples.push({
path: path.relative(PROJECT_ROOT, file),
lines: content.split(’\n’).length,
preview: content.substring(0, 500)
});
} catch (e) {
// Ignorer
}
}
