samples.components.push(…readFileSamples(componentFiles, 5));
}

// Services/API
const serviceDirs = […findDirectories(PROJECT_ROOT, ‘services’, 3), …findDirectories(PROJECT_ROOT, ‘api’, 3)];
for (const dir of serviceDirs) {
