import { Controller, Get, Query } from '@nestjs/common';
import { ProxyDemoOrdersService } from './proxy-demo-orders.service';

@Controller('/api/missions')
export class MissionsHttpController {
  constructor(private readonly proxy: ProxyDemoOrdersService) {}

  @Get()
  async list(@Query('status') status?: string, @Query('partnerSlug') partnerSlug?: string) {
    // MVP: missions = demo orders (READY by default)
    const st = status || 'READY';
    const resp = await this.proxy.listDemoOrders({ partnerSlug, status: st });
    const items = resp?.json?.items ?? resp?.json?.orders ?? [];
    return { ok: true, items, source: 'demo-orders', http: resp.status };
  }
}
