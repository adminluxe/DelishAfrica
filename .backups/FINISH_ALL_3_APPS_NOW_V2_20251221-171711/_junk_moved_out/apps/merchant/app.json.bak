{
  "name": "merchant",
  "slug": "merchant",
  "version": "1.0.0",
  "orientation": "portrait",
  "icon": "./assets/images/icon.png",
  "scheme": "merchant",
  "userInterfaceStyle": "automatic",
  "newArchEnabled": true,
  "ios": {
    "supportsTablet": true
  },
  "android": {
    "adaptiveIcon": {
      "backgroundColor": "#E6F4FE",
      "foregroundImage": "./assets/images/android-icon-foreground.png",
      "backgroundImage": "./assets/images/android-icon-background.png",
      "monochromeImage": "./assets/images/android-icon-monochrome.png"
    },
    "edgeToEdgeEnabled": true,
    "predictiveBackGestureEnabled": false
  },
  "web": {
    "bundler": "metro"
  },
  "plugins": [
    "expo-router",
    [
      "expo-splash-screen",
      {
        "image": "./assets/images/splash-icon.png",
        "imageWidth": 200,
        "resizeMode": "contain",
        "backgroundColor": "#ffffff",
        "dark": {
          "backgroundColor": "#000000"
        }
      }
    ]
  ],
  "experiments": {
    "typedRoutes": true
  },
  "extra": {
    "API_BASE_URL": "http://localhost:4001",
    "MERCHANT_ID": "merch_0001"
  },
  "expo": {
    "extra": {
      "API_BASE_URL": "https://api.delishafrica.me",
      "MERCHANT_ID": "merch_0001",
      "eas": {
        "projectId": "eebd079d-b168-422d-bfa7-2414edaf998e"
      }
    },
    "name": "DelishAfrica Merchant",
    "slug": "delish-merchant",
    "owner": "purpleorchidgroup",
    "scheme": "delish-merchant",
    "plugins": [
      "expo-dev-client",
      "expo-dev-client"
    ],
    "ios": {
      "bundleIdentifier": "me.delishafrica.merchant"
    },
    "android": {
      "package": "me.delishafrica.merchant"
    }
  }
}