#!/usr/bin/env bash
set -euo pipefail

BASE="http://127.0.0.1:4001"
MERCHANT_ID="merch_0001"
CUSTOMER_ID="client_0001"
COURIER_ID="courier_0001"
PRODUCT_ID="menu_0001"
ORDER_ID="order_test_full_001"
CSV="/tmp/menu_template.csv"

echo "🚦 [1/7] Vérification de l’API..."
curl -fsS "$BASE/api/health" | jq . || { echo "❌ API injoignable"; exit 1; }

echo "📦 [2/7] Préparation d’un menu CSV test..."
cat >"$CSV" <<'CSV'
name,price,category,description
Yassa Poulet,12.9,Plat,"Poulet mariné citron-oignon"
Alloco,5,Accompagnement,"Banane plantain frite"
CSV
awk -F, -v OFS=, -v ID="$MERCHANT_ID" 'NR==1{print "merchant_id",$0;next}{print ID,$0}' "$CSV" > /tmp/menu_upload.csv

echo "📤 [3/7] Import du menu pour $MERCHANT_ID..."
curl -s -X POST "$BASE/api/merchants/import-menu" \
  -F "file=@/tmp/menu_upload.csv;type=text/csv" | jq .

echo "🧾 [4/7] Injection commande test liée à $COURIER_ID..."
curl -s -X POST "$BASE/api/orders" \
  -H "Content-Type: application/json" \
  -d "{
        \\"id\\": \\"$ORDER_ID\\",
        \\"merchantId\\": \\"$MERCHANT_ID\\",
        \\"customerId\\": \\"$CUSTOMER_ID\\",
        \\"items\\": [ { \\"id\\": \\"$PRODUCT_ID\\", \\"quantity\\": 1 } ],
        \\"assignCourierId\\": \\"$COURIER_ID\\"
      }" | jq .

echo "📸 [5/7] Génération d’une preuve photo automatique..."
cat >/tmp/proof.png <<'EOF'
iVBORw0KGgoAAAANSUhEUgAAAAEAAAABCAYAAAAfFcSJAAAADUlEQVR4nGP4z8DwHwAFWAIpJr9CegAAAABJRU5ErkJggg==
EOF
curl -s -X POST "$BASE/api/couriers/jobs/$ORDER_ID/proof" \
  -F "file=@/tmp/proof.png;type=image/png" | jq .

echo "🚀 [6/7] Lancement des apps Expo (3 terminaux)..."

gnome-terminal -- bash -c "cd /opt/delishafrica/monorepo/apps/courier && pnpm dev; exec bash" 2>/dev/null || echo "Lance manuellement: cd apps/courier && pnpm dev"
gnome-terminal -- bash -c "cd /opt/delishafrica/monorepo/apps/client && pnpm dev; exec bash" 2>/dev/null || echo "Lance manuellement: cd apps/client && pnpm dev"
gnome-terminal -- bash -c "cd /opt/delishafrica/monorepo/apps/marchand && pnpm dev; exec bash" 2>/dev/null || echo "Lance manuellement: cd apps/marchand && pnpm dev"

echo "🎯 [7/7] Tu peux scanner les QR codes sur Expo Go pour chaque app. Coursier + Client + Marchand prêts ✅"
