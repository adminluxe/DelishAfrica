// apps/courier/components/AppBackground.tsx
import React from 'react';
import { ImageBackground, View } from 'react-native';

type Props = {
  children?: React.ReactNode;
  /** "routes" = routes & pins (livraison), "textures" = textures africaines géométriques */
  variant?: 'routes' | 'textures';
  /** Opacité globale de la tuile (0 → 1) */
  opacity?: number;
  /** Active un léger LinearGradient si expo-linear-gradient est présent (safe fallback sinon) */
  gradient?: boolean;
};

// --- Tuiles base64 ultra-légères ---
// routes & pins : micro-motif 8x8 (fond clair, gris doux + point “pin”)
const TILE_ROUTES_PINS =
  'iVBORw0KGgoAAAANSUhEUgAAAAgAAAAICAYAAADEUlfTAAAAI0lEQVQYV2NkYGD4z0ABYBxVgAEjQH4ZgNEDMWB0gkEwAABlTwCA7M3k1sAAAAASUVORK5CYII=';

// textures africaines géométriques : micro-motif 8x8 (chevrons subtils)
const TILE_TEXTURES =
  'iVBORw0KGgoAAAANSUhEUgAAAAgAAAAICAYAAADEUlfTAAAAKklEQVQYV2NkIAIwElQwMDCAwP//Z2BgYJgJg0EwQwQxwJgYhHAgAE8QwABuKcL6qU4b2wAAAAASUVORK5CYII=';

export default function AppBackground({
  children,
  variant = 'routes',
  opacity = 0.08,
  gradient = true,
}: Props) {
  // Sélection de la tuile
  const source =
    variant === 'routes'
      ? { uri: `data:image/png;base64,${TILE_ROUTES_PINS}` }
      : { uri: `data:image/png;base64,${TILE_TEXTURES}` };

  // Chargement "safe" du gradient : si le module n'est pas installé, on tombe sur View sans crasher
  let Gradient: any = null;
  if (gradient) {
    try {
      // eslint-disable-next-line @typescript-eslint/no-var-requires
      Gradient = require('expo-linear-gradient').LinearGradient;
    } catch {
      Gradient = null;
    }
  }

  const Wrapper: React.ComponentType<any> = Gradient || View;
  const wrapperProps = Gradient
    ? {
        colors: ['rgba(0,0,0,0.06)', 'rgba(0,0,0,0.00)'],
        start: { x: 0, y: 0 },
        end: { x: 1, y: 1 },
        style: { flex: 1 },
      }
    : { style: { flex: 1 } };

  return (
    <ImageBackground
      source={source}
      resizeMode="repeat"
      style={{ flex: 1, opacity }}
      imageStyle={{ opacity: 1 }}
    >
      <Wrapper {...wrapperProps}>
        <View style={{ flex: 1 }}>{children}</View>
      </Wrapper>
    </ImageBackground>
  );
}
