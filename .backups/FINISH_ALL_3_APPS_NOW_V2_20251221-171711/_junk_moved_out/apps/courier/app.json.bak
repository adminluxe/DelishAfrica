{
  "expo": {
    "name": "DelishAfrica Courier",
    "slug": "delishafrica-courier",
    "scheme": "delishcourier",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.delishafrica.courier"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#FFFFFF"
      },
      "package": "com.delishafrica.courier"
    },
    "plugins": [
      "expo-secure-store",
      "expo-image-picker",
      "react-native-maps",
      "expo-dev-client"
    ],
    "extra": {
      "API_BASE_URL": "https://api.delishafrica.me",
      "GMAPS_API_KEY": "AizaSyDaZ9aTEHf0m2Hrvruf-ahLoANqG__xpq0"
    }
  },
  "ios": {
    "jsEngine": "jsc",
    "infoPlist": {
      "NSLocationWhenInUseUsageDescription": "App uses your location to navigate deliveries."
    }
  },
  "android": {
    "jsEngine": "jsc",
    "permissions": [
      "ACCESS_FINE_LOCATION"
    ]
  }
}