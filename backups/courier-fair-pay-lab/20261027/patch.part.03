diff --git a/services/api-nest/src/courier-compensation/france-weekly-guarantee.spec.ts b/services/api-nest/src/courier-compensation/france-weekly-guarantee.spec.ts
new file mode 100644
index 0000000..d42c9ab
--- /dev/null
+++ b/services/api-nest/src/courier-compensation/france-weekly-guarantee.spec.ts
@@ -0,0 +1,149 @@
+import { equal, throws } from 'node:assert/strict';
+import { test } from 'node:test';
+import {
+  computeFranceCourierWeeklyGuarantee,
+  computeFranceCourierWeeklyGuarantees,
+  minimumGuaranteedIncomeCents,
+} from './france-weekly-guarantee';
+
+test('19 €/activity-hour weekly floor excludes tips from covered income', () => {
+  const result = computeFranceCourierWeeklyGuarantee([
+    {
+      courierId: 'courier-1',
+      missionId: 'mission-1',
+      weekKey: '2026-W44',
+      estimatedActivitySeconds: 3600,
+      activityIncomeCents: 1800,
+      tipsCents: 500,
+    },
+  ]);
+
+  equal(result.minimumGuaranteedIncomeCents, 1900);
+  equal(result.coveredIncomeCents, 1800);
+  equal(result.tipsExcludedCents, 500);
+  equal(result.differentialDueCents, 100);
+  equal(result.guaranteeSatisfied, false);
+  equal(result.differentialPaymentDelayDays, 7);
+});
+
+test('weekly aggregation uses cumulative estimated activity duration', () => {
+  const result = computeFranceCourierWeeklyGuarantee([
+    {
+      courierId: 'courier-1',
+      missionId: 'mission-1',
+      weekKey: '2026-W44',
+      estimatedActivitySeconds: 1800,
+      activityIncomeCents: 950,
+    },
+    {
+      courierId: 'courier-1',
+      missionId: 'mission-2',
+      weekKey: '2026-W44',
+      estimatedActivitySeconds: 1800,
+      activityIncomeCents: 950,
+    },
+  ]);
+
+  equal(result.coveredActivitySeconds, 3600);
+  equal(result.minimumGuaranteedIncomeCents, 1900);
+  equal(result.differentialDueCents, 0);
+  equal(result.guaranteeSatisfied, true);
+});
+
+test('minimum guarantee rounds upward to the next cent', () => {
+  equal(minimumGuaranteedIncomeCents(1), 1);
+  equal(minimumGuaranteedIncomeCents(1800), 950);
+  equal(minimumGuaranteedIncomeCents(3600), 1900);
+});
+
+test('records are grouped by courier and week', () => {
+  const results = computeFranceCourierWeeklyGuarantees([
+    {
+      courierId: 'courier-b',
+      missionId: 'mission-3',
+      weekKey: '2026-W44',
+      estimatedActivitySeconds: 3600,
+      activityIncomeCents: 1700,
+    },
+    {
+      courierId: 'courier-a',
+      missionId: 'mission-1',
+      weekKey: '2026-W44',
+      estimatedActivitySeconds: 1800,
+      activityIncomeCents: 900,
+    },
+    {
+      courierId: 'courier-a',
+      missionId: 'mission-2',
+      weekKey: '2026-W44',
+      estimatedActivitySeconds: 1800,
+      activityIncomeCents: 1000,
+    },
+  ]);
+
+  equal(results.length, 2);
+  equal(results[0].courierId, 'courier-a');
+  equal(results[0].differentialDueCents, 0);
+  equal(results[1].courierId, 'courier-b');
+  equal(results[1].differentialDueCents, 200);
+});
+
+test('mixed courier/week inputs are rejected by single-week calculation', () => {
+  throws(
+    () =>
+      computeFranceCourierWeeklyGuarantee([
+        {
+          courierId: 'courier-1',
+          missionId: 'mission-1',
+          weekKey: '2026-W44',
+          estimatedActivitySeconds: 100,
+          activityIncomeCents: 100,
+        },
+        {
+          courierId: 'courier-2',
+          missionId: 'mission-2',
+          weekKey: '2026-W44',
+          estimatedActivitySeconds: 100,
+          activityIncomeCents: 100,
+        },
+      ]),
+    /MIXED_COURIERS/,
+  );
+
+  throws(
+    () =>
+      computeFranceCourierWeeklyGuarantee([
+        {
+          courierId: 'courier-1',
+          missionId: 'mission-1',
+          weekKey: '2026-W44',
+          estimatedActivitySeconds: 100,
+          activityIncomeCents: 100,
+        },
+        {
+          courierId: 'courier-1',
+          missionId: 'mission-2',
+          weekKey: '2026-W45',
+          estimatedActivitySeconds: 100,
+          activityIncomeCents: 100,
+        },
+      ]),
+    /MIXED_WEEKS/,
+  );
+});
+
+test('negative or unsafe numeric values are rejected', () => {
+  throws(
+    () =>
+      computeFranceCourierWeeklyGuarantee([
+        {
+          courierId: 'courier-1',
+          missionId: 'mission-1',
+          weekKey: '2026-W44',
+          estimatedActivitySeconds: -1,
+          activityIncomeCents: 100,
+        },
+      ]),
+    /INVALID_ESTIMATEDACTIVITYSECONDS/,
+  );
+});
diff --git a/services/api-nest/src/courier-compensation/france-weekly-guarantee.ts b/services/api-nest/src/courier-compensation/france-weekly-guarantee.ts
new file mode 100644
index 0000000..6125d15
--- /dev/null
+++ b/services/api-nest/src/courier-compensation/france-weekly-guarantee.ts
@@ -0,0 +1,147 @@
+export const FRANCE_COURIER_MIN_ACTIVITY_RATE_CENTS_PER_HOUR = 1900;
+export const FRANCE_COURIER_DIFFERENTIAL_PAYMENT_DELAY_DAYS = 7;
+export const FRANCE_COURIER_GUARANTEE_VERSION = 'FR-ARPE-2026-09-01-v1';
+
+export interface FranceCourierActivityRecord {
+  courierId: string;
+  missionId: string;
+  weekKey: string;
+  estimatedActivitySeconds: number;
+  activityIncomeCents: number;
+  tipsCents?: number;
+}
+
+export interface FranceCourierWeeklyGuaranteeResult {
+  courierId: string;
+  weekKey: string;
+  coveredMissionCount: number;
+  coveredActivitySeconds: number;
+  coveredIncomeCents: number;
+  tipsExcludedCents: number;
+  minimumGuaranteedIncomeCents: number;
+  differentialDueCents: number;
+  guaranteeSatisfied: boolean;
+  calculationVersion: string;
+  differentialPaymentDelayDays: number;
+}
+
+function assertNonNegativeSafeInteger(value: number, field: string): void {
+  if (!Number.isSafeInteger(value) || value < 0) {
+    throw new Error(`FRANCE_COURIER_GUARANTEE_INVALID_${field.toUpperCase()}`);
+  }
+}
+
+function assertRequiredText(value: string, field: string): void {
+  if (!String(value || '').trim()) {
+    throw new Error(`FRANCE_COURIER_GUARANTEE_INVALID_${field.toUpperCase()}`);
+  }
+}
+
+export function minimumGuaranteedIncomeCents(
+  coveredActivitySeconds: number,
+): number {
+  assertNonNegativeSafeInteger(coveredActivitySeconds, 'coveredActivitySeconds');
+
+  if (coveredActivitySeconds === 0) return 0;
+
+  return Math.ceil(
+    (coveredActivitySeconds * FRANCE_COURIER_MIN_ACTIVITY_RATE_CENTS_PER_HOUR) /
+      3600,
+  );
+}
+
+export function computeFranceCourierWeeklyGuarantee(
+  records: FranceCourierActivityRecord[],
+): FranceCourierWeeklyGuaranteeResult {
+  if (!Array.isArray(records) || records.length === 0) {
+    throw new Error('FRANCE_COURIER_GUARANTEE_EMPTY_WEEK');
+  }
+
+  const courierId = String(records[0].courierId || '').trim();
+  const weekKey = String(records[0].weekKey || '').trim();
+  assertRequiredText(courierId, 'courierId');
+  assertRequiredText(weekKey, 'weekKey');
+
+  let coveredActivitySeconds = 0;
+  let coveredIncomeCents = 0;
+  let tipsExcludedCents = 0;
+
+  for (const record of records) {
+    assertRequiredText(record.courierId, 'courierId');
+    assertRequiredText(record.missionId, 'missionId');
+    assertRequiredText(record.weekKey, 'weekKey');
+
+    if (String(record.courierId).trim() !== courierId) {
+      throw new Error('FRANCE_COURIER_GUARANTEE_MIXED_COURIERS');
+    }
+    if (String(record.weekKey).trim() !== weekKey) {
+      throw new Error('FRANCE_COURIER_GUARANTEE_MIXED_WEEKS');
+    }
+
+    assertNonNegativeSafeInteger(
+      record.estimatedActivitySeconds,
+      'estimatedActivitySeconds',
+    );
+    assertNonNegativeSafeInteger(record.activityIncomeCents, 'activityIncomeCents');
+
+    const tipsCents = record.tipsCents ?? 0;
+    assertNonNegativeSafeInteger(tipsCents, 'tipsCents');
+
+    coveredActivitySeconds += record.estimatedActivitySeconds;
+    coveredIncomeCents += record.activityIncomeCents;
+    tipsExcludedCents += tipsCents;
+
+    if (
+      !Number.isSafeInteger(coveredActivitySeconds) ||
+      !Number.isSafeInteger(coveredIncomeCents) ||
+      !Number.isSafeInteger(tipsExcludedCents)
+    ) {
+      throw new Error('FRANCE_COURIER_GUARANTEE_TOTAL_OVERFLOW');
+    }
+  }
+
+  const minimumGuaranteedIncome =
+    minimumGuaranteedIncomeCents(coveredActivitySeconds);
+  const differentialDueCents = Math.max(
+    0,
+    minimumGuaranteedIncome - coveredIncomeCents,
+  );
+
+  return {
+    courierId,
+    weekKey,
+    coveredMissionCount: records.length,
+    coveredActivitySeconds,
+    coveredIncomeCents,
+    tipsExcludedCents,
+    minimumGuaranteedIncomeCents: minimumGuaranteedIncome,
+    differentialDueCents,
+    guaranteeSatisfied: differentialDueCents === 0,
+    calculationVersion: FRANCE_COURIER_GUARANTEE_VERSION,
+    differentialPaymentDelayDays:
+      FRANCE_COURIER_DIFFERENTIAL_PAYMENT_DELAY_DAYS,
+  };
+}
+
+export function computeFranceCourierWeeklyGuarantees(
+  records: FranceCourierActivityRecord[],
+): FranceCourierWeeklyGuaranteeResult[] {
+  const grouped = new Map<string, FranceCourierActivityRecord[]>();
+
+  for (const record of records) {
+    assertRequiredText(record.courierId, 'courierId');
+    assertRequiredText(record.weekKey, 'weekKey');
+    const key = `${String(record.courierId).trim()}::${String(record.weekKey).trim()}`;
+    const bucket = grouped.get(key) || [];
+    bucket.push(record);
+    grouped.set(key, bucket);
+  }
+
+  return Array.from(grouped.values())
+    .map((bucket) => computeFranceCourierWeeklyGuarantee(bucket))
+    .sort((a, b) =>
+      a.weekKey === b.weekKey
+        ? a.courierId.localeCompare(b.courierId)
+        : a.weekKey.localeCompare(b.weekKey),
+    );
+}
diff --git a/services/api-nest/src/courier-payroll/adapters/belgium.ts b/services/api-nest/src/courier-payroll/adapters/belgium.ts
new file mode 100644
index 0000000..bbd20c3
--- /dev/null
+++ b/services/api-nest/src/courier-payroll/adapters/belgium.ts
@@ -0,0 +1,40 @@
+import { CountryPayPolicy } from '../courier-payroll.types';
+
+export interface BelgiumEmployeeLabPolicyOptions {
+  legalFloorCentsPerPaidHour?: number | null;
+  pogFairnessFloorCentsPerPaidHour?: number;
+}
+
+export function createBelgiumEmployeeLabPolicy(
+  options: BelgiumEmployeeLabPolicyOptions = {},
+): CountryPayPolicy {
+  return {
+    policyId: 'BE-EMPLOYEE-POG-FAIR-PAY-LAB-v0.1',
+    countryCode: 'BE',
+    currency: 'EUR',
+    workerStatus: 'EMPLOYEE',
+    validationStatus: 'DRAFT',
+    effectiveFrom: null,
+    legalFloorCentsPerPaidHour:
+      options.legalFloorCentsPerPaidHour ?? null,
+    pogFairnessFloorCentsPerPaidHour:
+      options.pogFairnessFloorCentsPerPaidHour ?? 1900,
