+      'Production must remain blocked until Belgian legal review is GREEN.',
+    ],
+  };
+}
diff --git a/services/api-nest/src/courier-payroll/adapters/france.ts b/services/api-nest/src/courier-payroll/adapters/france.ts
new file mode 100644
index 0000000..c22da01
