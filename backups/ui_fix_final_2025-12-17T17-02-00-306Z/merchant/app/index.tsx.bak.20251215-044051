import React, { useCallback, useEffect, useMemo, useState } from "react";
import Constants from "expo-constants";
import { ActivityIndicator, Platform, Pressable, SafeAreaView, Text, View } from "react-native";

const API =
  process.env.EXPO_PUBLIC_API_URL ||
  (Constants.expoConfig?.extra as any)?.EXPO_PUBLIC_API_URL ||
  "https://api.delishafrica.me";

async function checkHealth(paths: string[]) {
  let lastErr: any = null;
  for (const p of paths) {
    try {
      const r = await fetch(`${API}${p}`, { method: "GET" });
      if (r.ok) return { ok: true, path: p, status: r.status };
      lastErr = new Error(`HTTP ${r.status} on ${p}`);
    } catch (e) {
      lastErr = e;
    }
  }
  return { ok: false, path: paths.join(" | "), err: String(lastErr?.message ?? lastErr ?? "unknown") };
}

async function fetchFirstOkJson(paths: string[]) {
  let lastErr: any = null;
  for (const p of paths) {
    try {
      const r = await fetch(`${API}${p}`, { method: "GET" });
      if (!r.ok) throw new Error(`HTTP ${r.status} on ${p}`);
      return { data: await r.json(), path: p };
    } catch (e) {
      lastErr = e;
    }
  }
  throw lastErr ?? new Error("No endpoint succeeded");
}

export default function Home() {
  const [healthOk, setHealthOk] = useState<"ok" | "nok" | "…">("…");
  const [healthPath, setHealthPath] = useState("");
  const [healthErr, setHealthErr] = useState("");
  const [loading, setLoading] = useState(false);
  const [partner, setPartner] = useState<any>(null);

  const iosHttpBlocked = useMemo(() => Platform.OS === "ios" && API.startsWith("http://"), []);

  const load = useCallback(async () => {
    setLoading(true);

    const h = await checkHealth(["/api/health", "/health"]);
    setHealthOk(h.ok ? "ok" : "nok");
    setHealthPath(h.path);
    setHealthErr(h.ok ? "" : (h.err ?? ""));

    try {
      const r = await fetchFirstOkJson(["/api/partners/thieyp", "/partners/thieyp"]);
      setPartner(r.data);
    } catch {
      setPartner({ name: "Thieyp", slug: "thieyp", city: "Bruxelles", note: "fallback" });
    } finally {
      setLoading(false);
    }
  }, []);

  useEffect(() => { load(); }, [load]);

  return (
    <SafeAreaView style={{ flex: 1 }}>
      <View style={{ position: "absolute", top: -120, right: -90, width: 320, height: 320, borderRadius: 999, backgroundColor: "#0B2A4A", opacity: 0.35 }} />
      <View style={{ position: "absolute", bottom: -140, left: -120, width: 360, height: 360, borderRadius: 999, backgroundColor: "#111827", opacity: 0.35 }} />

      <View style={{ flex: 1, padding: 16 }}>
        <Text style={{ color: "#FFFFFF", fontSize: 26, fontWeight: "900" }}>DelishAfrica</Text>
        <Text style={{ color: "#9CA3AF", marginTop: 6 }}>App Merchant • Poste cuisine & commandes</Text>

        <View style={{ height: 12 }} />

        <View style={{ backgroundColor: "#0B1220", borderRadius: 18, padding: 14, borderWidth: 1, borderColor: "#1F2937" }}>
          <Text style={{ color: "#E5E7EB", fontWeight: "900" }}>Connexion</Text>
          <Text style={{ color: "#9CA3AF", marginTop: 6, fontSize: 12 }}>API: {API}</Text>
          {iosHttpBlocked && <Text style={{ color: "#FDE68A", marginTop: 6, fontSize: 12 }}>⚠️ iOS bloque souvent HTTP → utilise HTTPS (tunnel Cloudflare).</Text>}
          <Text style={{ color: healthOk === "ok" ? "#86EFAC" : "#FCA5A5", marginTop: 6, fontSize: 12 }}>
            Health: {healthOk} ({healthPath})
          </Text>
          {!!healthErr && <Text style={{ color: "#FCA5A5", marginTop: 6, fontSize: 12 }}>Erreur: {healthErr}</Text>}

          <View style={{ height: 10 }} />

          <Pressable onPress={load} style={{ alignSelf: "flex-start", backgroundColor: "#111827", paddingHorizontal: 12, paddingVertical: 10, borderRadius: 14, borderWidth: 1, borderColor: "#1F2937" }}>
            <Text style={{ color: "#93C5FD", fontWeight: "900" }}>↻ Rafraîchir</Text>
          </Pressable>
        </View>

        <View style={{ height: 14 }} />

        <Text style={{ color: "#FFFFFF", fontSize: 18, fontWeight: "900", marginBottom: 10 }}>Restaurant connecté (démo)</Text>

        {loading && <ActivityIndicator />}

        {!loading && (
          <View style={{ backgroundColor: "#0B1220", borderRadius: 18, padding: 16, borderWidth: 1, borderColor: "#1F2937" }}>
            <Text style={{ color: "#FFFFFF", fontSize: 20, fontWeight: "900" }}>{partner?.name ?? "Thieyp"}</Text>
            <Text style={{ color: "#9CA3AF", marginTop: 8 }}>
              {partner?.city ?? "Bruxelles"} • slug: {partner?.slug ?? "thieyp"}
            </Text>

            <View style={{ height: 12 }} />

            <View style={{ backgroundColor: "#111827", borderRadius: 14, padding: 12, borderWidth: 1, borderColor: "#1F2937" }}>
              <Text style={{ color: "#E5E7EB", fontWeight: "900" }}>Prochaine étape</Text>
              <Text style={{ color: "#9CA3AF", marginTop: 6, lineHeight: 20 }}>
                Réception commande → accepter/refuser → préparation → prêt.
              </Text>
            </View>
          </View>
        )}
      </View>
    </SafeAreaView>
  );
}
