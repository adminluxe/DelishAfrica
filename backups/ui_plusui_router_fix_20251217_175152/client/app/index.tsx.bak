import { useEffect, useState } from "react";
import {
  ActivityIndicator,
  Pressable,
  SafeAreaView,
  ScrollView,
  Text,
  View,
} from "react-native";

const API_BASE =
  process.env.EXPO_PUBLIC_API_URL ?? "https://api.delishafrica.me";

export default function ClientHomeScreen() {
  const [health, setHealth] = useState<"unknown" | "ok" | "nok">("unknown");
  const [loading, setLoading] = useState(true);
  const [error, setError] = useState<string | null>(null);

  useEffect(() => {
    const run = async () => {
      try {
        const res = await fetch(`${API_BASE}/api/health`);
        if (!res.ok) throw new Error("Erreur health");
        await res.json();
        setHealth("ok");
      } catch {
        setHealth("nok");
      } finally {
        setLoading(false);
      }
    };
    run();
  }, []);

  return (
    <SafeAreaView style={{ flex: 1, backgroundColor: "#020617" }}>
      <ScrollView
        contentContainerStyle={{ padding: 16 }}
        showsVerticalScrollIndicator={false}
      >
        {/* Header */}
        <View style={{ marginBottom: 20 }}>
          <Text
            style={{
              fontSize: 28,
              fontWeight: "700",
              color: "#f9fafb",
              marginBottom: 6,
            }}
          >
            DelishAfrica – Client
          </Text>

          <Text style={{ color: "#9ca3af" }}>
            Interface Cliente – Mode démonstration
          </Text>
        </View>

        {/* API Info */}
        <View
          style={{
            padding: 16,
            borderRadius: 16,
            backgroundColor: "#0f172a",
            borderWidth: 1,
            borderColor: "#1e293b",
            marginBottom: 20,
          }}
        >
          <Text style={{ color: "#9ca3af", marginBottom: 4 }}>
            API utilisée :
          </Text>
          <Text style={{ color: "#e5e7eb", marginBottom: 8 }}>
            {API_BASE}
          </Text>

          <View style={{ flexDirection: "row", alignItems: "center" }}>
            <View
              style={{
                width: 10,
                height: 10,
                borderRadius: 999,
                marginRight: 6,
                backgroundColor:
                  health === "ok"
                    ? "#22c55e"
                    : health === "nok"
                    ? "#ef4444"
                    : "#f59e0b",
              }}
            />
            <Text style={{ color: "#e5e7eb" }}>
              {health === "unknown"
                ? "Vérification…"
                : health === "ok"
                ? "API opérationnelle"
                : "API injoignable"}
            </Text>
          </View>
        </View>

        {/* DEMO PLACEHOLDER */}
        <View
          style={{
            padding: 24,
            borderRadius: 20,
            backgroundColor: "#0b1120",
            borderWidth: 1,
            borderColor: "#1e293b",
          }}
        >
          <Text
            style={{
              color: "#a5b4fc",
              fontSize: 13,
              marginBottom: 8,
            }}
          >
            Mode démo
          </Text>

          <Text
            style={{
              fontSize: 20,
              fontWeight: "700",
              color: "#f9fafb",
              marginBottom: 10,
            }}
          >
            Bienvenue dans l’app Client
          </Text>

          <Text style={{ color: "#9ca3af", lineHeight: 20 }}>
            L’interface affichera bientôt les restaurants, menus et commandes.
            Cette version est la base stable pour la démonstration Thieyp.
          </Text>
        </View>
      </ScrollView>
    </SafeAreaView>
  );
}
