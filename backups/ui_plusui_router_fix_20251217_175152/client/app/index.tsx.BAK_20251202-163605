import React, { useEffect, useState, useCallback } from "react";
import {
  SafeAreaView,
  Text,
  ScrollView,
  RefreshControl,
  ActivityIndicator,
  View,
} from "react-native";

const API = process.env.EXPO_PUBLIC_API_URL ?? "https://api.delishafrica.me";

export default function Home() {
  const [health, setHealth] = useState("unknown");
  const [partners, setPartners] = useState([]);
  const [thieyp, setThieyp] = useState(null);
  const [refreshing, setRefreshing] = useState(false);
  const [loading, setLoading] = useState(true);

  const reload = useCallback(async () => {
    setRefreshing(true);
    try {
      const [h, p, t] = await Promise.all([
        fetch(`${API}/api/health`).then((r) => r.json()),
        fetch(`${API}/api/partners`).then((r) => r.json()),
        fetch(`${API}/api/partners/thieyp`).then((r) => r.json()),
      ]);

      setHealth(h?.status ?? "nok");
      setPartners(Array.isArray(p) ? p : p.items ?? []);
      setThieyp(t ?? null);
    } catch (e) {
      setHealth("nok");
    }
    setLoading(false);
    setRefreshing(false);
  }, []);

  useEffect(() => {
    reload();
  }, []);

  return (
    <SafeAreaView style={{ flex: 1, backgroundColor: "#0b0f19" }}>
      <ScrollView
        contentContainerStyle={{ padding: 16 }}
        refreshControl={
          <RefreshControl refreshing={refreshing} onRefresh={reload} />
        }
      >
        <Text style={{ color: "#F97316", fontSize: 24, fontWeight: "700" }}>
          DelishAfrica – Client
        </Text>

        <Text style={{ color: "white", marginTop: 8 }}>API: {API}</Text>
        <Text
          style={{
            color: health === "ok" ? "#22c55e" : "#ef4444",
            marginTop: 8,
            fontWeight: "700",
          }}
        >
          Health: {health}
        </Text>

        {loading && (
          <ActivityIndicator style={{ marginTop: 20 }} color="#F97316" />
        )}

        {thieyp && (
          <View
            style={{
              backgroundColor: "#1e2635",
              padding: 16,
              marginTop: 20,
              borderRadius: 12,
            }}
          >
            <Text style={{ color: "#9ca3af" }}>Partenaire mis en avant</Text>
            <Text
              style={{ color: "white", fontSize: 20, fontWeight: "700" }}
            >
              {thieyp.name}
            </Text>
            <Text style={{ color: "#d1d5db", marginTop: 8 }}>
              {thieyp.description}
            </Text>
          </View>
        )}

        {partners.map((p, i) => (
          <View
            key={i}
            style={{
              backgroundColor: "#1e2635",
              padding: 16,
              marginTop: 12,
              borderRadius: 12,
            }}
          >
            <Text style={{ color: "white", fontSize: 17, fontWeight: "600" }}>
              {p.name}
            </Text>
            <Text style={{ color: "#9ca3af" }}>{p.city}</Text>
          </View>
        ))}
      </ScrollView>
    </SafeAreaView>
  );
}
