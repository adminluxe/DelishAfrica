import React, { useCallback, useEffect, useRef, useState } from 'react';
import { ActivityIndicator, Alert, FlatList, Pressable, RefreshControl, SafeAreaView, StyleSheet, Text, View } from 'react-native';
import { useRouter } from 'expo-router';
import Constants from 'expo-constants';
import { apiFetch } from '../utils/api';
import { clearToken } from '../utils/auth';

type Job = { id: string; title?: string; pickupAddress?: string; dropoffAddress?: string; distanceKm?: number; etaMin?: number; };

const API_BASE=(Constants.expoConfig?.extra?.API_BASE_URL || process.env.API_BASE_URL || 'https://api.delishafrica.me');
export default function CourierHome() {
  const router = useRouter();
  const EXTRA = Constants.expoConfig?.extra || {};
  const API = (EXTRA.API_BASE_URL || EXTRA.API_URL || 'https://api.delishafrica.me').replace(/\/+$/,'');
  const [loading, setLoading] = useState(true);
  const [jobs, setJobs] = useState<Job[]>([]);
  const [error, setError] = useState<string | null>(null);
  const [refreshing, setRefreshing] = useState(false);
  const [lastTick, setLastTick] = useState('');
  const timerRef = useRef<ReturnType<typeof setInterval> | null>(null);

  const fetchJobs = useCallback(async () => {
    try {
      const r = await apiFetch(`/api/couriers/jobs/available`);
      if (!r.ok) throw new Error(`HTTP ${r.status}`);
      const data = await r.json();
      const list: Job[] = Array.isArray(data) ? data : (data?.items ?? []);
      setJobs(list);
      setError(null);
      setLastTick(new Date().toLocaleTimeString());
    } catch (e: any) {
      setError(e?.message ?? 'Erreur réseau');
    } finally {
      setLoading(false);
      setRefreshing(false);
    }
  }, []);

  useEffect(() => {
    fetchJobs();
    timerRef.current = setInterval(fetchJobs, 5000);
    return () => { if (timerRef.current) clearInterval(timerRef.current); };
  }, [fetchJobs]);

  const onRefresh = useCallback(() => { setRefreshing(true); fetchJobs(); }, [fetchJobs]);

  const handleAccept = useCallback(async (id: string) => {
    try {
      const r = await apiFetch(`/api/couriers/jobs/${id}/accept`, { method: 'POST' });
      if (!r.ok) throw new Error(`HTTP ${r.status}`);
      router.replace(`/job/${id}`);
    } catch { router.replace(`/job/${id}`); }
  }, [router]);

  const renderItem = ({ item }: { item: Job }) => (
    <View style={styles.card}>
      <Text style={styles.cardTitle}>{item.title ?? `Course ${item.id}`}</Text>
      <Text style={styles.cardSub}>{item.pickupAddress ?? 'Pickup — à préciser'}</Text>
      <Text style={styles.cardSub}>{item.dropoffAddress ?? 'Dropoff — à préciser'}</Text>
      <View style={styles.row}>
        <Text style={styles.badge}>{item.distanceKm ? `${item.distanceKm.toFixed(1)} km` : '—'}</Text>
        <Text style={styles.badge}>{item.etaMin ? `~${item.etaMin} min` : '—'}</Text>
      </View>
      <Pressable onPress={() => handleAccept(item.id)} style={styles.btnPrimary}><Text style={styles.btnPrimaryText}>Accepter</Text></Pressable>
    </View>
  );

  return (
    <SafeAreaView style={styles.screen}>
      <Text style={styles.title}>DelishAfrica · Coursier</Text>
      <View style={styles.hud}>
        <Text style={styles.hudText}>API: {API}</Text>
        <Text style={styles.hudText}>Dernier refresh: {lastTick || '—'}</Text>
      </View>
      <Pressable onPress={async()=>{ await clearToken(); router.replace('/login'); }} style={{alignSelf:'center', padding:6}}>
        <Text style={{color:'#9CA3AF'}}>Se déconnecter</Text>
      </Pressable>

      {loading ? (
        <View style={styles.center}><ActivityIndicator /><Text style={styles.muted}>Chargement…</Text></View>
      ) : error ? (
        <View style={styles.center}><Text style={styles.err}>Erreur : {error}</Text><Pressable onPress={fetchJobs} style={styles.btnGhost}><Text>Réessayer</Text></Pressable></View>
      ) : jobs.length === 0 ? (
        <View style={styles.center}><Text style={styles.muted}>Aucune course disponible pour l’instant.</Text><Text style={styles.mutedSmall}>Rafraîchissement automatique toutes les 5s…</Text></View>
      ) : (
        <FlatList data={jobs} keyExtractor={(x)=>x.id} renderItem={renderItem} contentContainerStyle={styles.listPad}
          refreshControl={<RefreshControl refreshing={refreshing} onRefresh={onRefresh} />} />
      )}
    </SafeAreaView>
  );
}

const styles = StyleSheet.create({
  screen: { flex: 1, backgroundColor: '#fff' },
  title: { textAlign: 'center', fontSize: 22, fontWeight: '700', marginTop: 8, marginBottom: 6 },
  hud: { alignItems: 'center', marginBottom: 8 }, hudText: { color: '#98A2B3', fontSize: 12 },
  center: { alignItems: 'center', justifyContent: 'center', paddingVertical: 24 },
  muted: { color: '#667085', marginTop: 8 }, mutedSmall: { color: '#98A2B3', marginTop: 4, fontSize: 12 },
  err: { color: '#B42318', fontWeight: '600' }, listPad: { paddingHorizontal: 14, paddingBottom: 24 },
  card: { backgroundColor: '#fff', borderRadius: 14, padding: 14, marginBottom: 12, borderWidth: 1, borderColor: '#EEF2F6',
          shadowColor: '#000', shadowOpacity: 0.06, shadowOffset: { width: 0, height: 4 }, shadowRadius: 10, elevation: 2 },
  cardTitle: { fontSize: 16, fontWeight: '700', marginBottom: 4 }, cardSub: { color: '#475467' },
  row: { flexDirection: 'row', gap: 8, marginTop: 8, marginBottom: 10 },
  badge: { paddingHorizontal: 10, paddingVertical: 4, borderRadius: 9999, backgroundColor: '#F2F4F7', color: '#344054' },
  btnPrimary: { backgroundColor: '#00A36D', borderRadius: 10, alignItems: 'center', paddingVertical: 10 },
  btnPrimaryText: { color: '#fff', fontWeight: '700' }, btnGhost: { padding: 8, marginTop: 6 },
});

// -- inject accept handler (safe add)
async function onAccept(jobId: string, setLoading: (v:boolean)=>void, router: any) {
  try {
    setLoading(true);
    const r = await fetch(`${API_BASE}/api/couriers/jobs/${jobId}/accept`, { method: 'POST' });
    const j = await r.json().catch(()=>({}));
    if (r.ok) { router.push(`/job/${jobId}`); }
    else { alert(j?.message || 'Acceptation impossible'); }
  } finally { setLoading(false); }
}
