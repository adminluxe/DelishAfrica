import React from 'react';
import { ScrollView, Text, View, StyleSheet } from 'react-native';

export type DemoMission = {
  id: string;
  code: string;
  status: 'à_affecter' | 'en_cours' | 'livrée';
  clientName: string;
  pickupAddress: string;
  dropoffAddress: string;
  etaMinutes: number;
  amount: string;
};

export const demoMissions: DemoMission[] = [
  {
    id: 'DA-M1001',
    code: 'DA-M1001',
    status: 'à_affecter',
    clientName: 'Amélie K.',
    pickupAddress: 'Mama Africa – Rue du Midi 45, Bruxelles',
    dropoffAddress: 'Avenue de la Toison d’Or 32, Bruxelles',
    etaMinutes: 12,
    amount: '42,80 €',
  },
  {
    id: 'DA-M1002',
    code: 'DA-M1002',
    status: 'en_cours',
    clientName: 'Nicolas B.',
    pickupAddress: 'Lagos Street Food – Chaussee de Haecht 200, Bruxelles',
    dropoffAddress: 'Avenue de la Couronne 120, Ixelles',
    etaMinutes: 18,
    amount: '27,40 €',
  },
  {
    id: 'DA-M1003',
    code: 'DA-M1003',
    status: 'livrée',
    clientName: 'Fatou S.',
    pickupAddress: 'Douala Corner – Chaussée de Mons 200, Bruxelles',
    dropoffAddress: 'Boulevard du Midi 15, Bruxelles',
    etaMinutes: 6,
    amount: '31,80 €',
  },
];

// Compatibilité si on importait DEMO_MISSIONS avant
export const DEMO_MISSIONS = demoMissions;

function statusLabel(status: DemoMission['status']): string {
  switch (status) {
    case 'à_affecter':
      return 'À affecter (démo)';
    case 'en_cours':
      return 'En cours (démo)';
    case 'livrée':
      return 'Livrée (démo)';
    default:
      return 'Statut inconnu';
  }
}

// Composant par défaut pour que Expo Router soit content
const DemoMissionsScreen: React.FC = () => {
  return (
    <ScrollView style={styles.container} contentContainerStyle={styles.content}>
      <Text style={styles.title}>Missions démo (courier)</Text>
      <Text style={styles.subtitle}>
        Écran helper. Dans la demo, on utilise surtout l&apos;écran d&apos;accueil
        et le détail mission.
      </Text>

      {demoMissions.map((m) => (
        <View key={m.id} style={styles.card}>
          <Text style={styles.code}>{m.code}</Text>
          <Text style={styles.line}>Client : {m.clientName}</Text>
          <Text style={styles.line}>Pickup : {m.pickupAddress}</Text>
          <Text style={styles.line}>Livraison : {m.dropoffAddress}</Text>
          <Text style={styles.line}>ETA coursier : {m.etaMinutes} min</Text>
          <Text style={styles.amount}>{m.amount}</Text>
          <Text style={styles.status}>{statusLabel(m.status)}</Text>
        </View>
      ))}
    </ScrollView>
  );
};

export default DemoMissionsScreen;

