import React, { useCallback, useMemo, useState } from 'react';
import { SafeAreaView, View, Text, Pressable, StyleSheet, Alert, Platform, Linking, Image } from 'react-native';
import { useLocalSearchParams, useRouter } from 'expo-router';
import { View } from 'react-native';
// (maps disabled)
import * as ImagePicker from 'expo-image-picker';
import ConfettiBurst from '../../components/ConfettiBurst';
import ProofPhotoModal from '../../components/ProofPhotoModal';
import Constants from 'expo-constants';
import { apiFetch } from '../../utils/api';

const EXTRA = Constants.expoConfig?.extra || {};
const GMAPS_KEY = EXTRA.GMAPS_API_KEY || '';
type Step = 'idle' | 'arrived-pickup' | 'picked' | 'arrived-dropoff' | 'delivered';

const DEMO = {
  pickup:   { latitude: 50.8327, longitude: 4.3666, label: 'Pickup · Matonge' },
  dropoff:  { latitude: 50.8335, longitude: 4.3576, label: 'Dropoff · Louise' },
};

export default function JobScreen() {
const API_BASE=(Constants.expoConfig?.extra?.API_BASE_URL||process.env.API_BASE_URL||'https://api.delishafrica.me');
const [showProof,setShowProof]=React.useState(false);
  const { id } = useLocalSearchParams<{ id: string }>();
  const router = useRouter();
  const [step, setStep] = useState<Step>('idle');
  const [confetti, setConfetti] = useState(false);
  const [eta, setEta] = useState<{ km?: number; min?: number }>({});
  const [lastProofUri, setLastProofUri] = useState<string | null>(null);
  const [sigOpen, setSigOpen] = useState(false);

  const pickup = DEMO.pickup, dropoff = DEMO.dropoff;
  const region = useMemo(() => ({ latitude: 50.8365, longitude: 4.3620, latitudeDelta: 0.03, longitudeDelta: 0.03 }), []);

  const openNativeNav = useCallback((lat: number, lon: number, label?: string) => {
    const q = encodeURIComponent(label ?? 'Destination');
    if (Platform.OS === 'ios') Linking.openURL(`http://maps.apple.com/?daddr=${lat},${lon}&q=${q}&dirflg=d`);
    else Linking.openURL(`https://www.google.com/maps/dir/?api=1&destination=${lat},${lon}&travelmode=driving`);
  }, []);

  const callStep = useCallback(async (s: Step, navigateAfter?: boolean) => {
    try {
      const r = await apiFetch(`/api/couriers/jobs/${id}/${s}`, { method: 'POST' });
      if (!r.ok) throw new Error(`HTTP ${r.status}`);
    } catch {}
    finally {
      setStep(s);
      if (navigateAfter) {
        if (s === 'arrived-pickup' || s === 'idle') openNativeNav(pickup.latitude, pickup.longitude, pickup.label);
        if (s === 'picked' || s === 'arrived-dropoff') openNativeNav(dropoff.latitude, dropoff.longitude, dropoff.label);
      }
      if (s === 'delivered') {
        setConfetti(true);
        setTimeout(() => router.replace('/home'), 1000);
      }
    }
  }, [id, openNativeNav, pickup.latitude, pickup.longitude, pickup.label, dropoff.latitude, dropoff.longitude, dropoff.label, router]);

  const origin = step === 'picked' || step === 'arrived-dropoff' ? pickup : pickup; // TODO: GPS réel
  const destination = step === 'picked' || step === 'arrived-dropoff' ? dropoff : pickup;

  const pickAndUploadProof = useCallback(async () => {
    const perm = await ImagePicker.requestMediaLibraryPermissionsAsync();
    if (!perm.granted) { Alert.alert('Permission requise', 'Autorise la galerie pour ajouter une preuve.'); return; }
    const res = await ImagePicker.launchImageLibraryAsync({ allowsMultipleSelection: false, quality: 0.8, mediaTypes: ImagePicker.MediaTypeOptions.Images });
    if (res.canceled) return;
    const asset = res.assets?.[0]; if (!asset?.uri) return;

    const form = new FormData();
    form.append('file', { uri: asset.uri, name: `proof_${id}.jpg`, type: 'image/jpeg' } as any);

    try {
      const r = await apiFetch(`/api/couriers/jobs/${id}/proof`, { method: 'POST', body: form });
      if (!r.ok) throw new Error(`HTTP ${r.status}`);
      setLastProofUri(asset.uri);
      Alert.alert('Preuve envoyée', 'Photo téléchargée.');
    } catch (e:any) {
      Alert.alert('Envoi impossible', e?.message ?? 'Erreur');
    }
  }, [id]);

  const onSignatureOK = useCallback(async (dataUrl: string) => {
    try {
      const r = await apiFetch(`/api/couriers/jobs/${id}/proof-signature`, {
        method: 'POST', body: JSON.stringify({ dataUrl })
      });
      if (!r.ok) throw new Error(`HTTP ${r.status}`);
      setSigOpen(false);
      Alert.alert('Signature enregistrée', 'Preuve ajoutée.');
    } catch (e:any) {
      Alert.alert('Erreur', e?.message ?? 'Impossible d’envoyer la signature');
    }
  }, [id]);

  return (
    <SafeAreaView style={S.screen}>
      <Text style={S.title}>Mission #{id}</Text>

      <View style={S.mapWrap}>
        <MapView style={S.map} initialRegion={region}>
          <Marker coordinate={pickup} title="Pickup" description={pickup.label} pinColor="#00A36D" />
          <Marker coordinate={dropoff} title="Dropoff" description={dropoff.label} />
          {GMAPS_KEY ? (
            <MapViewDirections
              origin={origin}
              destination={destination}
              apikey={GMAPS_KEY}
              strokeWidth={5}
              strokeColor="#00A36D"
              onReady={(res) => setEta({ km: res.distance, min: Math.round(res.duration) })}
            />
          ) : null}
        </View>
      </View>

      {eta.km ? <Text style={S.eta}>{eta.km.toFixed(1)} km · ~{eta.min} min</Text>
              : <Text style={S.etaMuted}>ETA en attente… {GMAPS_KEY ? '' : '(clé Google Directions manquante)'}</Text>}

      <Pressable style={[S.btn, S.btnFull]} onPress={() => openNativeNav(destination.latitude, destination.longitude, destination.label)}>
        <Text style={S.btnText}>Ouvrir la navigation native</Text>
      </Pressable>

      <View style={S.row}>
        <Pressable style={S.btn} onPress={() => callStep('arrived-pickup', true)}><Text style={S.btnText}>Arrivé au pickup</Text></Pressable>
        <Pressable style={S.btn} onPress={() => callStep('picked', true)}><Text style={S.btnText}>Récupéré</Text></Pressable>
      </View>

      <View style={S.row}>
        <Pressable style={S.btn} onPress={() => callStep('arrived-dropoff', true)}><Text style={S.btnText}>Arrivé au client</Text></Pressable>
        <Pressable style={S.btnSecondary} onPress={pickAndUploadProof}><Text style={S.btnSecondaryText}>Preuve photo (galerie)</Text></Pressable>
      </View>

      <Pressable style={[S.btnSecondary, S.btnFull]} onPress={() => setSigOpen(true)}>
        <Text style={[S.btnSecondaryText, { fontWeight: '800' }]}>Signature manuscrite ✍️</Text>
      </Pressable>

      <Pressable style={[S.btn, S.btnFull, S.btnSuccess]} onPress={() => callStep('delivered')}>
        <Text style={S.btnSuccessText}>Livré 🎉</Text>
      </Pressable>

      {lastProofUri ? (
        <View style={S.proofPreview}>
          <Text style={S.previewTitle}>Dernière preuve (photo)</Text>
          <Image source={{ uri: lastProofUri }} style={S.previewImg} />
        </View>
      ) : null}

      {confetti && <ConfettiBurst />}
      <ProofPhotoModal visible={sigOpen} onOK={onSignatureOK} onCancel={() => setSigOpen(false)} />
    </SafeAreaView>
  );
}

const S = StyleSheet.create({
  screen: { flex: 1, backgroundColor: '#fff' },
  title: { textAlign: 'center', fontSize: 20, fontWeight: '700', marginVertical: 10 },
  mapWrap: { height: 300, borderRadius: 14, overflow: 'hidden', marginHorizontal: 14, borderWidth: 1, borderColor: '#EEF2F6' },
  map: { flex: 1 },
  eta: { textAlign: 'center', marginTop: 8, fontWeight: '700' },
  etaMuted: { textAlign: 'center', marginTop: 8, color: '#6B7280' },
  row: { flexDirection: 'row', gap: 10, marginTop: 12, marginHorizontal: 14 },
  btn: { flex: 1, backgroundColor: '#00A36D', paddingVertical: 12, borderRadius: 10, alignItems: 'center' },
  btnText: { color: '#fff', fontWeight: '700' },
  btnSecondary: { flex: 1, backgroundColor: '#F2F4F7', paddingVertical: 12, borderRadius: 10, alignItems: 'center' },
  btnSecondaryText: { color: '#344054', fontWeight: '700' },
  btnFull: { marginHorizontal: 14, marginTop: 12 },
  btnSuccess: { backgroundColor: '#059669' },
  btnSuccessText: { color: '#fff', fontWeight: '800' },
  proofPreview: { marginTop: 14, marginHorizontal: 14, alignItems: 'center' },
  previewTitle: { fontWeight: '700', marginBottom: 6 },
  previewImg: { width: 180, height: 120, borderRadius: 8, borderWidth: 1, borderColor: '#E5E7EB' }
});
