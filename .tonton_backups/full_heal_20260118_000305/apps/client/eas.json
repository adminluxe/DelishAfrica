{
  "cli": {
    "version": ">= 16.27.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "corepack": true,
      "pnpm": "9.12.1",
      "env": {
        "NPM_CONFIG_LEGACY_PEER_DEPS": "true",
        "NPM_CONFIG_FUND": "false",
        "NPM_CONFIG_AUDIT": "false",
        "EXPO_DOCTOR_SKIP_DEPENDENCY_VERSION_CHECK": "1"
      }
    },
    "preview": {
      "distribution": "internal",
      "corepack": true,
      "pnpm": "9.12.1"
    },
    "production": {
      "autoIncrement": true,
      "corepack": true,
      "pnpm": "9.12.1"
    }
  },
  "submit": {
    "production": {}
  }
}
